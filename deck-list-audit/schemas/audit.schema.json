{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunamismax.local/schemas/audit.schema.json",
  "type": "object",
  "required": ["schema_version", "audit_date", "generator", "inputs", "summary", "decks"],
  "properties": {
    "schema_version": {"const": 2},
    "audit_date": {"type": "string", "format": "date"},
    "summary": {
      "type": "object",
      "required": ["deck_count", "valid_deck_count", "invalid_deck_count", "valid"]
    },
    "decks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["slug", "deck_sha256", "valid", "errors", "warnings", "total_cards", "resolved_cards"]
      }
    }
  }
}
