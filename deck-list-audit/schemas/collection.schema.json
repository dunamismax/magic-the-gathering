{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunamismax.local/schemas/collection.schema.json",
  "type": "object",
  "required": ["schema_version", "collection", "freshness", "sources", "decks"],
  "properties": {
    "schema_version": {"const": 1},
    "decks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["commanders", "title", "moxfield_id", "source_updated_on", "source_refreshed_on", "visibility", "constraints"],
        "properties": {
          "commanders": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
          "title": {"type": "string", "minLength": 1},
          "moxfield_id": {"type": "string", "minLength": 1},
          "source_updated_on": {"type": "string", "format": "date"},
          "source_refreshed_on": {"type": "string", "format": "date"},
          "visibility": {"enum": ["public", "private"]},
          "sideboard": {
            "type": "object",
            "required": ["file", "purpose", "swap_out", "target_bracket"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "swap_out": {"type": "array", "items": {"type": "string"}},
              "target_bracket": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          },
          "constraints": {
            "type": "object",
            "required": ["target_bracket", "game_changer_max", "combo_policy", "rule_zero_cards", "locked_cards"],
            "properties": {
              "bracket_exception_cards": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
