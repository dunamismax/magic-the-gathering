{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunamismax.local/schemas/combo-adjudications.schema.json",
  "type": "object",
  "required": ["schema_version", "reviewed_on", "decks"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deck", "deck_sha256", "summary", "lines"]
      }
    }
  }
}
