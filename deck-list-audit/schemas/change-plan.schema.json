{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunamismax.local/schemas/change-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "deck", "baseline_sha256", "adds", "cuts"],
  "properties": {
    "schema_version": {"const": 1},
    "deck": {"type": "string", "minLength": 1},
    "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "game_changer_policy": {"enum": ["no-increase", "configured-maximum"]},
    "adds": {"$ref": "#/$defs/cards"},
    "cuts": {"$ref": "#/$defs/cards"}
  },
  "$defs": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "quantity": {"type": "integer", "minimum": 1},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
