    {{python}} "{{root}}/scripts/classify_roles.py"

test:
    PYTHONDONTWRITEBYTECODE=1 {{python}} -m unittest discover -s "{{root}}/tests" -v

lint:
    ruff check "{{root}}/scripts" "{{root}}/tests"

